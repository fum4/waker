# waker.yaml, written by `waker init`.
# Validate with `waker check`; every other key, with its default:
# https://github.com/fum4/waker#every-key-with-its-default

apps:
  - name:     blog
    listen:   0.0.0.0:8080           # open to other machines; 127.0.0.1 behind a proxy
    upstream: http://127.0.0.1:3000  # where the app itself serves
    start:    [python3, -m, http.server, "3000", --bind, 127.0.0.1]
    idle:     30m                    # stop after this long without a request
    health:
      path: /  # up = a GET below 400

# How `waker service install` runs waker. Every key is optional; these are
# the defaults. Uncomment to change one, then run `waker service install`.
# service:
#  restart: always  # always | on-failure | never (your own supervisor)
#  path:    ~/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
#  system:  false   # true: a system service (root) instead of a user one
#  start:   true    # false: install and enable without (re)starting
#  env:     {}      # extra environment, e.g. {NODE_ENV: production}
#  user:    ""      # system: true only; default: the installing user

# Whether waker looks for a newer release (one request a day to
# releases.nomadware.io) and installs it. The defaults:
# update:
#  check: true   # false: never look (or set WAKER_NO_UPDATE_CHECK=1)
#  auto:  false  # true: serve installs it at start, rolls back if it fails
